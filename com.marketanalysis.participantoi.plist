<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.marketanalysis.participantoi</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/sunildeesu/MarketAnalysisOI/run_nightly.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/sunildeesu/MarketAnalysisOI</string>

    <!-- 20:30 local (= 8:30 PM IST) on weekdays only. Weekday 1=Mon .. 5=Fri.
         Market holidays that fall on a weekday are handled at runtime: the script
         no-ops when NSE has published no participant file for the day. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key><integer>1</integer>
            <key>Hour</key><integer>20</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>2</integer>
            <key>Hour</key><integer>20</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>3</integer>
            <key>Hour</key><integer>20</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>4</integer>
            <key>Hour</key><integer>20</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>5</integer>
            <key>Hour</key><integer>20</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
    </array>

    <!-- If the Mac was asleep at 20:30, launchd runs it once on next wake -->
    <key>RunAtLoad</key>
    <false/>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/Users/sunildeesu/MarketAnalysisOI/logs/participant_oi.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/sunildeesu/MarketAnalysisOI/logs/participant_oi.err.log</string>
</dict>
</plist>
