<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.marketanalysis.participantoi</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/sunildeesu/MarketAnalysisOI/run_nightly.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/sunildeesu/MarketAnalysisOI</string>

    <!-- Two fires per weekday (1=Mon .. 5=Fri): 20:30 local (8:30 PM IST) for early
         delivery, plus a 22:30 (10:30 PM IST) fallback. NSE usually publishes the
         participant file 6:30-7:30 PM IST but occasionally after 8:30 PM (seen as
         late as ~8:57 PM), so the 8:30 run can miss those days; the 10:30 run then
         catches them. run_nightly.sh commits only when report_data.hash changes and
         discards an identical rebuild, so the second run is a harmless no-op whenever
         the first already captured the data. Weekday holidays are handled at runtime:
         the script no-ops when NSE has published no participant file for the day. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key><integer>1</integer>
            <key>Hour</key><integer>20</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>2</integer>
            <key>Hour</key><integer>20</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>3</integer>
            <key>Hour</key><integer>20</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>4</integer>
            <key>Hour</key><integer>20</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>5</integer>
            <key>Hour</key><integer>20</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>1</integer>
            <key>Hour</key><integer>22</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>2</integer>
            <key>Hour</key><integer>22</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>3</integer>
            <key>Hour</key><integer>22</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>4</integer>
            <key>Hour</key><integer>22</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>5</integer>
            <key>Hour</key><integer>22</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
    </array>

    <!-- If the Mac was asleep at a fire time, launchd runs it once on next wake -->
    <key>RunAtLoad</key>
    <false/>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/Users/sunildeesu/MarketAnalysisOI/logs/participant_oi.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/sunildeesu/MarketAnalysisOI/logs/participant_oi.err.log</string>
</dict>
</plist>
